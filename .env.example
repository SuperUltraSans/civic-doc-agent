# 루트 .env — docker compose 가 읽는다 (커밋 금지).
# 1) 포트·바인드 주소 (docker-compose.yml 변수)
# 2) 백엔드 환경 변수 (back 컨테이너에 env_file 로 그대로 들어간다. 항목 설명은 back/.env.example)

# ── Docker 포트 ──
BIND_ADDR=127.0.0.1     # 휴대폰 실기기 시험 때만 0.0.0.0
BACK_PORT=8000
FRONT_PORT=3000

# ── 프론트 ──
VITE_USE_MOCK=false     # true 면 백엔드 없이 목업 시나리오로 동작
VITE_MOCK_SPEED=normal  # normal | fast

# ── 백엔드 (필요한 것만 채운다. 비어 있는 값은 back/.env.example 기본값을 따른다) ──
AGENT_MODE=live         # live | scripted
# LLM: 문서 읽기 Gemini 3.8 Flash / 계획 GPT-6.1 Sol / 빠른 GPT-6 Luna (AWS Bedrock 은 쓰지 않는다)
LLM_PROVIDER=openai     # openai | google | anthropic | fake
PROVIDER_VISION=google
MODEL_VISION=gemini-3.8-flash
MODEL_REASON=gpt-6.1-sol
MODEL_FAST=gpt-6-luna
OPENAI_API_KEY=
GEMINI_API_KEY=
DATA_GO_KR_SERVICE_KEY=
NAVER_SEARCH_API=hub     # NAVER API HUB 검색 키 (예전 개발자센터 키면 developers)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
