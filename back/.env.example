# 읽어드림 백엔드 환경 변수 — 이 파일을 .env 로 복사해 값을 채운다. (.env 는 커밋 금지)

# 공통
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173   # 쉼표로 여러 개 (front 컨테이너 3000, Vite 개발 서버 5173)
TZ_NAME=Asia/Seoul

# 에이전트
AGENT_MODE=live                 # live | scripted (scripted = 프론트 목업 시나리오 재생, 실제 동작 아님)
LLM_PROVIDER=bedrock            # bedrock | anthropic | fake
# 모델 ID는 코드에 쓰지 않는다. Bedrock 콘솔에서 계정·리전에 활성화된 ID(추론 프로필 포함)를 확인해 넣는다.
# 하나만 채우면 나머지 역할도 그 모델을 쓴다.
MODEL_VISION=
MODEL_REASON=
MODEL_FAST=
LLM_EFFORT=                     # 비우면 보내지 않음. anthropic 공급자에서만 사용 (low | medium | high)
LLM_MAX_TOKENS=8000             # 최신 모델은 thinking 토큰도 여기에 포함된다 → 너무 낮으면 출력이 잘린다
BEDROCK_STRUCTURED_METHOD=json_schema   # json_schema | function_calling

# Bedrock
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Anthropic API (대안)
ANTHROPIC_API_KEY=
LLM_API_BASE_URL=https://api.anthropic.com   # SDK가 ANTHROPIC_BASE_URL 환경 변수를 따라가지 않게 고정
LLM_REFUSAL_FALLBACK=default    # 안전 분류기 거절 시 서버가 다른 모델로 재실행 (비우면 끔)

# 외부 데이터
DATA_GO_KR_SERVICE_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
EXTERNAL_TIMEOUT_SECONDS=5

# 세션
SESSION_TTL_SECONDS=600
SESSION_LINGER_SECONDS=120
RESULT_TTL_SECONDS=1800
ANSWER_TIMEOUT_SECONDS=180
MAX_CONCURRENT_SESSIONS=20
RATE_LIMIT_PER_MINUTE=20
SSE_PING_SECONDS=15
SCRIPTED_SPEED=normal           # normal | fast
