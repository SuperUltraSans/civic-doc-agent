# 읽어드림 백엔드 환경 변수 — 이 파일을 .env 로 복사해 값을 채운다. (.env 는 커밋 금지)

# 공통
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173   # 쉼표로 여러 개 (front 컨테이너 3000, Vite 개발 서버 5173)
TZ_NAME=Asia/Seoul

# 에이전트
AGENT_MODE=live                 # live | scripted (scripted = 프론트 목업 시나리오 재생, 실제 동작 아님)

# LLM — 역할마다 공급자·모델을 따로 정한다 (AWS Bedrock 은 쓰지 않는다)
#   문서 읽기(vision): Gemini 3.8 Flash / 계획(reason): GPT-6.1 Sol / 빠른(fast, 설명·복지 재정렬·수법 선택): GPT-6 Luna
LLM_PROVIDER=openai             # 기본 공급자: openai | google | anthropic | fake (fake 면 모든 역할이 기록된 응답)
PROVIDER_VISION=google          # 비우면 LLM_PROVIDER
PROVIDER_REASON=
PROVIDER_FAST=
MODEL_VISION=gemini-3.8-flash
MODEL_REASON=gpt-6.1-sol
MODEL_FAST=gpt-6-luna
# 사고 수준. 비우면 보내지 않음(공급자 기본값). 역할별 EFFORT_* 가 비어 있으면 LLM_EFFORT.
#   google(thinking_level): low | medium | high   openai(reasoning.effort): none(Luna만) | low | medium | high
LLM_EFFORT=
EFFORT_VISION=
EFFORT_REASON=
EFFORT_FAST=
LLM_MAX_TOKENS=8000             # 사고 토큰도 여기에 포함된다 → 너무 낮으면 출력이 잘린다
# Gemini 이미지 해상도(이미지당 토큰): low 280 | medium 560 | high 1120 | ultra_high 2240. 비우면 기본(= high)
GEMINI_MEDIA_RESOLUTION=
# 사진 품질 사전 점검(너무 작음·어두움·밝음·흐림이면 LLM 호출 없이 다시 찍기). 오작동하면 false
PHOTO_CHECK_ENABLED=true

# 공급자 키 (커밋 금지)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=              # 선택 공급자. 기본 구성에서는 쓰지 않음
# 주소 고정: SDK가 OPENAI_BASE_URL·ANTHROPIC_BASE_URL 같은 환경 변수를 따라가 키가 엉뚱한 주소로 가지 않게 한다
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_REFUSAL_FALLBACK=default    # anthropic 전용: 안전 분류기 거절 시 서버가 다른 모델로 재실행 (비우면 끔)

# 외부 데이터
DATA_GO_KR_SERVICE_KEY=
# 네이버 웹문서 검색: 2026년 NAVER API HUB 로 이관 (개발자센터 신규 발급 종료). hub | developers(예전 개발자센터 키)
NAVER_SEARCH_API=hub
NAVER_CLIENT_ID=                # HUB: API_HUB_CLIENT_ID (X-NCP-APIGW-API-KEY-ID)
NAVER_CLIENT_SECRET=            # HUB: API_HUB_CLIENT_SECRET (X-NCP-APIGW-API-KEY)
EXTERNAL_TIMEOUT_SECONDS=5

# 세션
SESSION_TTL_SECONDS=600
SESSION_LINGER_SECONDS=120
RESULT_TTL_SECONDS=1800
ANSWER_TIMEOUT_SECONDS=180
MAX_CONCURRENT_SESSIONS=20
RATE_LIMIT_PER_MINUTE=20
SSE_PING_SECONDS=15
SCRIPTED_SPEED=normal           # normal | fast
