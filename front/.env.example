# 읽어드림 프론트 환경 변수 — 이 파일을 .env 로 복사해 쓴다 (.env 는 커밋 금지)

# true 이면 목업 API(src/api/mock)를 쓴다. 백엔드 없이 화면 전체를 시연할 수 있다.
# false 이면 실제 백엔드(/api/...)에 연결한다.
VITE_USE_MOCK=true

# 목업 재생 속도: normal(단계당 0.8~2초) | fast(단계당 0.2초)
VITE_MOCK_SPEED=normal

# 백엔드 주소. 비우면 앱과 같은 경로 아래의 /api 를 쓴다
# (개발 서버·Docker 는 프록시로 연결됨, 엣지 배포는 /civic-doc-agent/api).
# 프론트와 백엔드를 다른 주소에 배포할 때만 채운다. 예: https://api.example.com
VITE_API_BASE_URL=

# 배포 경로 (빌드할 때만). 엣지 배포는 /civic-doc-agent/ — Dockerfile.prod 가 넣는다
# BASE_PATH=/
